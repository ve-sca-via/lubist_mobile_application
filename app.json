{
  "expo": {
    "name": "Lubist Mobile",
    "slug": "lubist-mobile-application",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f3efe7"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lubist.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Lubist uses your location to show salons near you."
      }
    },
    "android": {
      "package": "com.lubist.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f3efe7"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Lubist uses your location to show salons near you."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "0c5d02f8-8571-42f1-a61a-5aea92ddd8a5"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/0c5d02f8-8571-42f1-a61a-5aea92ddd8a5"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
