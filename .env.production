# Production API base URL.
#
# WHY THIS FILE EXISTS: `eas update` bundles JS locally and reads .env files - it
# does NOT read the `env` block in eas.json (that only applies to `eas build`).
# Without this file, whatever is in .env (a staging/local override) gets inlined
# into an OTA bundle and shipped to production users.
#
# `expo export` - which `eas update` runs - bundles in production mode, so this
# file takes precedence over .env. Keep .env for local/staging work.
EXPO_PUBLIC_API_URL=https://lubist-p7aah.ondigitalocean.app
EXPO_PUBLIC_WEB_URL=https://www.lubist.com
